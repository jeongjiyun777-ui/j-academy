# Copy this file to backend/config/.env for local development.
# In production, configure the same names in your hosting platform's environment settings.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academy_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password

# Browser origins allowed to call this API (comma-separated in production)
FRONTEND_ORIGINS=http://localhost:3000

# Authentication and administrator account
# Generate a long random value; never reuse this example value in production.
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=정지윤
ADMIN_USERNAME=admin@example.com
# Generate a hash with pwdlib; never store a plaintext administrator password here.
# python -c "from pwdlib import PasswordHash; print(PasswordHash.recommended().hash('change-this-password'))"
ADMIN_PASSWORD_HASH=replace-with-a-pwdlib-password-hash
ADMIN_AGE=25

# Administrator email notifications
# Gmail example: enable 2-step verification, create an App Password, then set SMTP_ENABLED=true.
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password

# AI consultation (optional; the current implementation returns fixed guidance)
OPENAI_API_KEY=

# Webhook note
# This repository has no active webhook integration. Do not add WEBHOOK_URL
# until an endpoint and signature/error handling are implemented.

