# Copy this file to frontend/.env.local for local development.
# NEXT_PUBLIC_ values are exposed to the browser. Do not put secrets here.

# Local FastAPI server
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production example (set this in the hosting platform, without a trailing slash)
# NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.example.com
